{
  "name": "aston-os",
  "version": "11.3.1",
  "private": true,
  "description": "ASTON OS 11.3.1 — edge decision fabric",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "node run.mjs",
    "check": "wrangler deploy --dry-run",
    "deploy": "node scripts/predeploy.mjs && wrangler deploy --config wrangler.toml",
    "db:init": "wrangler d1 execute aston-omni-primary --remote --file=schema.sql && wrangler d1 execute aston-omni-backup --remote --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  }
}
