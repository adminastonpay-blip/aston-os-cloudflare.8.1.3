  }
  @media (prefers-reduced-motion: reduce) {
    #{{ aston_section_id }} *, #{{ aston_section_id }} *::before, #{{ aston_section_id }} *::after { transition-duration: .01ms !important; scroll-behavior: auto !important; }
  }
</style>

<script>
  (() => {
    const root = document.getElementById({{ aston_section_id | json }});
    if (!root || root.dataset.astonInitialized === 'true') return;
    root.dataset.astonInitialized = 'true';
    const search = root.querySelector('[data-aston-search]');
    const cards = Array.from(root.querySelectorAll('[data-aston-card]'));
    const filters = Array.from(root.querySelectorAll('[data-aston-filter]'));
    const count = root.querySelector('[data-aston-count]');
    const empty = root.querySelector('[data-aston-empty]');
    let activeCategory = 'all';
    const update = () => {
      const query = (search?.value || '').trim().toLocaleLowerCase();
      let visible = 0;
      cards.forEach(card => {
        const matchesCategory = activeCategory === 'all' || card.dataset.category === activeCategory;
        const matchesQuery = !query || (card.dataset.search || '').toLocaleLowerCase().includes(query);
        const show = matchesCategory && matchesQuery;
        card.hidden = !show;
        if (show) visible += 1;
      });
      if (count) count.textContent = String(visible);
      if (empty) empty.hidden = visible !== 0;
    };
    filters.forEach(button => button.addEventListener('click', () => {
      activeCategory = button.dataset.astonFilter || 'all';
      filters.forEach(filter => {
        const selected = filter === button;
        filter.classList.toggle('is-active', selected);
        filter.setAttribute('aria-pressed', selected ? 'true' : 'false');
      });
      update();
    }));
    search?.addEventListener('input', update);
    update();
  })();
</script>

{% schema %}
{
  "name": "Global Command",
  "tag": "section",
  "class": "section-aston-global-command",
  "settings": [
    {"type":"text","id":"eyebrow","label":"Texto superior","default":"ASTON OS · GLOBAL INTELLIGENCE"},
    {"type":"text","id":"heading","label":"Título","default":"Un centro de comando para resolver problemas complejos."},
    {"type":"textarea","id":"intro","label":"Descripción","default":"Conectá inteligencia, investigación, ingeniería y operaciones en un único espacio de trabajo. Elegí una capacidad, definí el objetivo y avanzá con control y trazabilidad."},
    {"type":"text","id":"primary_label","label":"Botón principal","default":"Explorar capacidades"},
    {"type":"url","id":"primary_url","label":"Enlace principal"},
    {"type":"text","id":"secondary_label","label":"Botón secundario","default":"Ver arquitectura"},
    {"type":"url","id":"secondary_url","label":"Enlace secundario"},
    {"type":"text","id":"status_title","label":"Estado del panel","default":"Panel configurable"},
    {"type":"text","id":"status_note","label":"Nota de integración","default":"Conexión con Worker a configurar"},
    {"type":"text","id":"catalog_label","label":"Título del catálogo","default":"Capacidades de ASTON"},
    {"type":"text","id":"capabilities_label","label":"Etiqueta de cantidad","default":"módulos"},
    {"type":"text","id":"search_label","label":"Etiqueta accesible de búsqueda","default":"Buscar capacidades"},
    {"type":"text","id":"search_placeholder","label":"Placeholder de búsqueda","default":"Buscar una capacidad..."},
    {"type":"text","id":"filters_label","label":"Etiqueta de filtros","default":"Filtrar por categoría"},
    {"type":"text","id":"all_label","label":"Filtro general","default":"Todas"},
    {"type":"text","id":"link_placeholder","label":"Texto sin enlace","default":"Enlace pendiente"},
    {"type":"text","id":"empty_message","label":"Mensaje sin resultados","default":"No encontramos capacidades con esos criterios. Probá con otra búsqueda."},
    {"type":"text","id":"footer_note","label":"Nota al pie","default":"Los módulos y estados se configuran desde el editor del tema. La conexión operativa requiere integrar los servicios correspondientes."},
    {"type":"color","id":"background_color","label":"Fondo","default":"#F7F9FC"},
    {"type":"color","id":"card_color","label":"Fondo de tarjetas","default":"#FFFFFF"},
    {"type":"color","id":"text_color","label":"Texto principal","default":"#172B4D"},
    {"type":"color","id":"muted_color","label":"Texto secundario","default":"#5E6C84"},
    {"type":"color","id":"accent_color","label":"Color de acento","default":"#2457C5"},
    {"type":"color","id":"border_color","label":"Bordes","default":"#DFE5EF"}
  ],
  "blocks": [
